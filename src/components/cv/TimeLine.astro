---
const { title, subtitle } = Astro.props;
---

<div class="flex">
  <div class="education__time">
    <span class="w-4 h-4 bg-ac-primary block rounded-full mt-1 ring-2 ring-ac-primary-light"></span>
    <span class="education__line bg-ac-primary/30 block h-full w-[2px] translate-x-[7px]"></span>
  </div>
  <div class="experience__data bd-grid px-4 pb-3">
    <h3 class="font-semibold leading-snug">{title}</h3>
    <span class="font-light text-sm">{subtitle}</span>
    <div class="mt-1 text-justify">
      <slot />
    </div>
  </div>
</div>
