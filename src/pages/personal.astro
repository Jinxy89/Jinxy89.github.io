<style>
    /* Warm brown underline, same family as the tag chips and the home email. */
    .email-link {
        color: #8d6e63;
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, #8d6e63 40%, transparent);
        text-underline-offset: 3px;
        transition: text-decoration-color 200ms ease;
    }

    .email-link:hover {
        text-decoration-color: #8d6e63;
    }

    .email-link:focus-visible {
        outline: 2px solid #8d6e63;
        outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
        .email-link {
            transition: none;
        }
    }
</style>
