---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import TagBar from "../../components/TagBar.astro";
import { PROJECT_TAGS } from "../../lib/tags";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";
import { AUTHOR_INITIAL, url as baseUrl } from "../../config";

export async function getStaticPaths({ paginate }) {
    // An empty collection yields undefined, so fall back to an empty list.
    const projects = (await getCollection("projects")) ?? [];
    projects.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );
    return paginate(projects, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout
    title={AUTHOR_INITIAL + " | Projects"}
    sideBarActiveItemID="projects"
>
    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Projects</div>
    </div>

    <TagBar tags={PROJECT_TAGS} />

    {
        page.data.length === 0 ? (
            <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
                <p class="font-bold">No projects yet!</p>
                <p>
                    There are no projects to show at the moment. Check back
                    later!
                </p>
            </div>
        ) : (
            <ul class="project-list">
                {page.data.map((project) => (
                    <li data-post-tags={(project.data.tags || []).join(",")}>
                        <HorizontalCard
                            title={project.data.title}
                            img={project.data.heroImage}
                            desc={project.data.description}
                            url={
                                baseUrl("projects/" +
                                createSlug(project.data.title, project.slug))
                            }
                            target="_self"
                            badge={project.data.badge}
                            tags={project.data.tags}
                        />
                        <div class="divider my-0" />
                    </li>
                ))}
            </ul>
        )
    }

    <div class="flex justify-between">
        {
            page.url.prev ? (
                <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
                    <svg
                        class="h-6 w-6 fill-current md:h-8 md:w-8"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                    >
                        <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
                    </svg>
                    Previous page
                </a>
            ) : (
                <div />
            )
        }
        {
            page.url.next ? (
                <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
                    Next page
                    <svg
                        class="h-6 w-6 fill-current md:h-8 md:w-8"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                    >
                        <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                    </svg>
                </a>
            ) : (
                <div />
            )
        }
    </div>
</BaseLayout>

<style>
    /* Keep the list area a fixed size so filtering down to one project (or
       none) does not collapse the page and jolt the layout. */
    .project-list {
        min-height: 32rem;
    }
</style>
