---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, url } from "../config";
---

<BaseLayout sideBarActiveItemID="home">
    <div class="pb-12 mt-5">
        <img src={url('favicon.svg')} alt="" class="w-24 h-24 mb-2" />
        <div class="text-xl py-1">Hey there</div>
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
            <div class="text-5xl font-bold">I'm {SITE_TITLE}</div>
            <div class="flex items-center gap-2">
                <a class="email-chip" href="mailto:jieyi.wang@gatech.edu">
                    jieyi.wang@gatech.edu
                </a>
                <a
                    class="linkedin-link"
                    href="https://www.linkedin.com/in/jinxywang"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn profile"
                    title="LinkedIn"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                        focusable="false"
                    >
                        <path
                            d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.64h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.66c0-1.35-.03-3.09-1.99-3.09-1.99 0-2.3 1.47-2.3 2.99V21h-4V9Z"
                        ></path>
                    </svg>
                </a>
            </div>
        </div>
        <div class="text-xl py-6 leading-relaxed max-w-2xl space-y-4">
            <p>
                I'm <span class="font-semibold">Jieyi Wang（王洁怡）</span>, also you can call me
                <span class="font-semibold">Jinxy</span> ٩(◕‿◕)۶
            </p>
            <p>
                I'm currently studying <span class="font-semibold">Mathematics and Computing</span> at
                <span class="font-semibold">Georgia Tech</span>, where I spend most of my time thinking about
                <span class="font-semibold">optimization</span> and
                <span class="font-semibold">neuro-inspired computing for decision making</span>. I love the moment
                when a messy real-world problem quietly turns into something you can actually solve, and I'd like
                to keep digging into that space for a long, long time (๑•̀ㅂ•́)و✧
            </p>
            <p>
                Away from the whiteboard, I like paiting, and excited about
                architecture design (you can find my Portfolio at Project) Last! I am interested in mysterous stuff and philosophy
                ପ(๑•ᴗ•๑)ଓ
            </p>
            <p>
                Feel free to look around, and know more about me, I am happy to connect! (｡•̀ᴗ-)✧
            </p>
        </div>
    </div>
</BaseLayout>

<style>
    /* Same warm-brown token the tag chips use, so the header reads as one family. */
    .email-chip {
        --tag-color: #8d6e63;
        padding: 0.3rem 0.85rem;
        border-radius: 999px;
        font-size: 0.875rem;
        line-height: 1.25rem;
        color: var(--tag-color);
        border: 1px solid color-mix(in srgb, var(--tag-color) 45%, transparent);
        background: color-mix(in srgb, var(--tag-color) 12%, transparent);
        transition:
            background-color 200ms ease,
            transform 200ms ease;
    }

    .email-chip:hover {
        background: color-mix(in srgb, var(--tag-color) 24%, transparent);
        transform: translateY(-1px);
    }

    .email-chip:focus-visible {
        outline: 2px solid var(--tag-color);
        outline-offset: 2px;
    }

    /* Framed square sibling of the chip: same border, tint, padding and content
       height, so the two sit at exactly the same height on the row. */
    .linkedin-link {
        --tag-color: #8d6e63;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.3rem;
        border-radius: 0.5rem;
        color: var(--tag-color);
        border: 1px solid color-mix(in srgb, var(--tag-color) 45%, transparent);
        background: color-mix(in srgb, var(--tag-color) 12%, transparent);
        transition:
            background-color 200ms ease,
            transform 200ms ease;
    }

    /* Matches the chip's 1.25rem line-height, which is what sets its height. */
    .linkedin-link svg {
        display: block;
        width: 1.25rem;
        height: 1.25rem;
    }

    .linkedin-link:hover {
        background: color-mix(in srgb, var(--tag-color) 24%, transparent);
        transform: translateY(-1px);
    }

    .linkedin-link:focus-visible {
        outline: 2px solid var(--tag-color);
        outline-offset: 2px;
        border-radius: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
        .email-chip,
        .linkedin-link {
            transition: none;
        }
        .email-chip:hover,
        .linkedin-link:hover {
            transform: none;
        }
    }
</style>
